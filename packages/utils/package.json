{
  "name": "@frontend-toolkit/utils",
  "version": "0.1.0",
  "description": "Type-safe utility functions for frontend development",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "typescript",
    "utils",
    "utilities",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  }
}
