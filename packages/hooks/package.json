{
  "name": "@frontend-toolkit-js/hooks",
  "version": "0.6.0",
  "description": "React hooks for better DX with type safety",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./useQueryParams/adapters/next-app": {
      "types": "./dist/useQueryParams/adapters/next-app.d.ts",
      "import": "./dist/useQueryParams/adapters/next-app.mjs",
      "require": "./dist/useQueryParams/adapters/next-app.js"
    },
    "./useQueryParams/adapters/next-pages": {
      "types": "./dist/useQueryParams/adapters/next-pages.d.ts",
      "import": "./dist/useQueryParams/adapters/next-pages.mjs",
      "require": "./dist/useQueryParams/adapters/next-pages.js"
    },
    "./useQueryParams/adapters/react-router": {
      "types": "./dist/useQueryParams/adapters/react-router.d.ts",
      "import": "./dist/useQueryParams/adapters/react-router.mjs",
      "require": "./dist/useQueryParams/adapters/react-router.js"
    },
    "./useFunnel/adapters/next-app": {
      "types": "./dist/useFunnel/adapters/next-app.d.ts",
      "import": "./dist/useFunnel/adapters/next-app.mjs",
      "require": "./dist/useFunnel/adapters/next-app.js"
    },
    "./useFunnel/adapters/next-pages": {
      "types": "./dist/useFunnel/adapters/next-pages.d.ts",
      "import": "./dist/useFunnel/adapters/next-pages.mjs",
      "require": "./dist/useFunnel/adapters/next-pages.js"
    },
    "./useFunnel/adapters/react-router": {
      "types": "./dist/useFunnel/adapters/react-router.d.ts",
      "import": "./dist/useFunnel/adapters/react-router.mjs",
      "require": "./dist/useFunnel/adapters/react-router.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "react",
    "hooks",
    "calendar",
    "date",
    "date-picker",
    "typescript",
    "frontend",
    "dx",
    "developer-experience"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rak517/frontend-toolkit.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/rak517/frontend-toolkit/issues"
  },
  "homepage": "https://github.com/rak517/frontend-toolkit#readme",
  "author": "rak517",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.18",
    "eslint": "^9.18.0",
    "next": "^16.0.10",
    "react": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
