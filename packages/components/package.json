{
  "name": "@frontend-toolkit-js/components",
  "version": "0.1.0",
  "description": "Declarative React UI components with type safety",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
